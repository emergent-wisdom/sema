# Web deploy for semahash.org — builds the React frontend and runs the
# FastAPI server that fronts the pattern graph + REST API.
#
# This is NOT the canonical repo-root Dockerfile. The root `Dockerfile`
# is the MCP stdio-server variant (the artifact Glama fetches at the
# canonical path). Railway is configured via the `RAILWAY_DOCKERFILE_PATH`
# environment variable to build from this file instead of the root one.

# ── Stage 1: compile the React frontend ──────────────────────────────
FROM node:20-slim AS web-builder

WORKDIR /app/web

# Railway exposes service variables as Docker build arguments. Keep the
# unfinished workspace UI out of canonical production by default, while
# allowing the separate staging project to opt in explicitly.
ARG VITE_ENABLE_WORKSPACE=false
ENV VITE_ENABLE_WORKSPACE=$VITE_ENABLE_WORKSPACE

# Lockfile-first for layer caching; only invalidated when deps change.
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
# Vite inlines VITE_* at build time; Railway passes service variables to
# Docker builds only as build args, so declare it or the workspace route
# gets silently compiled out of deploys.
ARG VITE_ENABLE_WORKSPACE
ENV VITE_ENABLE_WORKSPACE=${VITE_ENABLE_WORKSPACE}
RUN npm run build

# ── Stage 2: Python runtime serving the compiled frontend + API ──────
FROM python:3.12-slim

WORKDIR /app

# gcc is needed for a few wheels that compile native extensions.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy only what the runtime needs. `pyproject.toml`'s force-include
# requires `.claude-plugin/` and `skills/` to exist at build time, so
# they must be copied before `pip install` even though they aren't
# imported at runtime.
COPY pyproject.toml README.md LICENSE LICENSE-CONTENT ./
COPY src/ ./src/
COPY data/ ./data/
COPY docs/ ./docs/
COPY .claude-plugin/ ./.claude-plugin/
COPY skills/ ./skills/
COPY paper/sema.pdf ./paper/sema.pdf

RUN pip install --no-cache-dir -e ".[api]"

# Drop the built frontend into the path `sema serve` expects.
COPY --from=web-builder /app/web/build/client/ ./src/sema/server/static/

# Railway injects $PORT at runtime; default to 3000 for local docker runs.
EXPOSE 3000

CMD sema serve --host 0.0.0.0 --port ${PORT:-3000}
