{
  "handle": "DepthGovernor",
  "mechanism": "Entropy-Bounded Recursion: Decomposition depth is not fixed but governed by informational entropy. {{agent}} measures uncertainty of current {{plan}}. If entropy exceeds `entropy_threshold`, {{decompose}} further; below it, execute. Stop thinking when uncertainty drops below action cost. Depth is a function of ambiguity, bounded by `max_depth` only as a backstop. It acts as the termination {{condition}} for {{recursion_dive}}, halting descent when informational entropy drops below the threshold.",
  "gloss": "Entropy-based stopping condition for recursion",
  "failure_modes": [
    "Ambiguity {{loop}}: entropy never drops because the {{problem}} is inherently subjective, so descent runs to `max_depth` and acts on an unresolved plan.",
    "Miscalculated entropy leads to premature action.",
    "Estimation overhead: measuring entropy costs more than the decomposition it avoids."
  ],
  "invariants": [
    "The governor cannot be bypassed.",
    "Descends only while entropy exceeds `entropy_threshold`.",
    "Never descends past `max_depth`, whatever the entropy."
  ],
  "parameters": [
    {
      "name": "entropy_threshold",
      "type": "Float",
      "range": "[0.1, 0.5]",
      "description": "Stop when uncertainty below this"
    },
    {
      "name": "max_depth",
      "type": "Integer",
      "range": "[3, 20]",
      "description": "Hard limit on recursion"
    }
  ],
