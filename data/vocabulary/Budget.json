{
  "handle": "Budget",
  "mechanism": "A quantified allocation of resources (compute, time, energy) that bounds execution against a finite pool. Whether the bound is enforced strictly or admits overdraft is a descendant concern; what Budget fixes is that consumption is accounted for rather than merely permitted.",
  "gloss": "Resource allocation limit",
  "data_schema": {
    "type": "object",
    "required": [
      "total",
      "remaining",
      "unit"
    ],
    "properties": {
      "total": {
        "type": "number",
        "description": "The initial allocated amount"
      },
      "remaining": {
        "type": "number",
        "description": "The current available amount"
      },
      "unit": {
        "type": "string",
        "enum": [
          "Tokens",
          "USD",
          "Ms"
        ],
        "description": "The unit of measurement"
      }
    }
  },
  "invariants": [
    "{{conservation}} of account: every change to Remaining corresponds to a recorded consumption or refund."
  ],
  "preconditions": [
    "Total budget defined"
  ],
  "postconditions": [
    "Budget decremented by cost"
  ],
