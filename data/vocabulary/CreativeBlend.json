{
  "handle": "CreativeBlend",
  "gloss": "Concept blending with novelty and value acceptance",
  "signature": [
    "Strategy(Artifact)"
  ],
  "mechanism": "A generative {{strategy}} that selects separated seed concepts from the {{context}} and fuses them via {{concept_blend}} into a candidate {{artifact}}. It runs two declared acceptance conditions through {{check}}: one derives from {{novelty}} relative to the seed inputs and one derives from {{value}}. The candidate is yielded only when both checks return Verified. Seed selection, candidate-generation tactics, and check criteria remain caller- or descendant-defined.",
  "invariants": [
    "Dual Acceptance: The declared {{novelty}} and {{value}} checks both return Verified for every yielded {{artifact}}."
  ],
